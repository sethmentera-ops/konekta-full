# Konekta Social App Environment Configuration
# PORT: Application server port (default 3000)
PORT=3000

# APP_URL: The domain where Konekta is hosted (Render / Custom Domain)
APP_URL="https://your-konekta-app.onrender.com"

# --- PIN / OTP verification ---
# Email (Gmail): enable 2-Step Verification, then create an App Password
# https://myaccount.google.com/apppasswords
GMAIL_USER="yourname@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# SMS (optional, Philippines): https://semaphore.co
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""

# Random string used to hash PIN codes
OTP_SECRET="change-me"

# Email via Brevo (free, no Gmail App Password needed): https://brevo.com
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# --- Shared database (Supabase) ---
# Supabase -> Project Settings -> API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY=""   # the secret service_role key. NEVER put it in the frontend or share it
# Secret used to sign login tokens (any long random text). Keep it stable.
SESSION_SECRET=""
